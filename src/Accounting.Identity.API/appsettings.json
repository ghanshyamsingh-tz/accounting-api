{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=nemtaccounting;Username=identity_service;Password=REPLACE_WITH_SECURE_PASSWORD;SearchPath=identity"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/nemtaccounting",
    "Audience": "identity-service",
    "ClientId": "identity-service",
    "ClientSecret": "REPLACE_WITH_CLIENT_SECRET",
    "RequireHttpsMetadata": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "identity:"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "identity-service-group",
    "EnableAutoCommit": true,
    "Topics": {
      "DomainEvents": "identity.domain-events",
      "SecurityEvents": "identity.security-events"
    }
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "Username": "noreply@nemtaccounting.example.com",
    "Password": "REPLACE_WITH_SMTP_PASSWORD",
    "FromAddress": "no-reply@nemtaccounting.example.com",
    "FromName": "NEMT Accounting Identity Service",
    "EnableSsl": true
  },
  "Sms": {
    "Provider": "Twilio",
    "AccountSid": "REPLACE_WITH_TWILIO_SID",
    "AuthToken": "REPLACE_WITH_TWILIO_AUTH_TOKEN",
    "FromNumber": "+1234567890"
  },
  "Geolocation": {
    "Provider": "IPGeolocation",
    "ApiKey": "REPLACE_WITH_API_KEY",
    "CacheTtlMinutes": 60
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    },
    "General": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  },
  "Security": {
    "BruteForce": {
      "FailedAttemptsThreshold": 5,
      "WindowMinutes": 10,
      "LockoutDurationMinutes": 30
    },
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    }
  },
  "Observability": {
    "ServiceName": "identity-service",
    "ServiceVersion": "1.0.0",
    "OpenTelemetry": {
      "Endpoint": "http://localhost:4318",
      "Protocol": "HttpProtobuf"
    },
    "Seq": {
      "ServerUrl": "http://localhost:5341",
      "ApiKey": ""
    }
  }
}
